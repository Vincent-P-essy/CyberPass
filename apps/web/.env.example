# Laisser NEXT_PUBLIC_API_URL vide pour le mode démonstration clairement signalé.
# En production, le navigateur et l’API doivent partager le même hostname (cookies host-only),
# idéalement derrière un reverse proxy : https://cyberpass.example/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL utilisée uniquement par le rendu SSR dans le réseau Docker.
INTERNAL_API_URL=http://api:8000/api/v1
