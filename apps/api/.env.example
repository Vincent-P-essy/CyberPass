APP_ENV=development
DATABASE_URL=postgresql+psycopg://cyberpass:cyberpass@localhost:5432/cyberpass
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
AUTH_RATE_LIMIT=10
AUTH_IP_RATE_LIMIT=60
AUTH_RATE_WINDOW_SECONDS=60
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY_BYTES=11534336
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=cyberpass-private
S3_ACCESS_KEY=minio
S3_SECRET_KEY=replace-me
S3_REGION=eu-west-3
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
GENERATION_RATE_LIMIT=5
GENERATION_RATE_WINDOW_SECONDS=60
GENERATION_CONCURRENCY_PER_TENANT=1
PUBLIC_SHARE_RATE_LIMIT=120
PUBLIC_SHARE_GLOBAL_RATE_LIMIT=2000
PUBLIC_SHARE_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=120
DOWNLOAD_GLOBAL_RATE_LIMIT=2000
FILE_RATE_WINDOW_SECONDS=60
TENANT_EVIDENCE_QUOTA=5000
TENANT_QUESTIONNAIRE_QUOTA=1000
