# Runtime
APP_ENV=development
APP_NAME=CyberPass
WEB_PORT=3000
API_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Authentication — replace before every non-local deployment
JWT_SECRET=development-only-replace-with-32-random-characters
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
AUTH_RATE_LIMIT=10
AUTH_IP_RATE_LIMIT=60
AUTH_RATE_WINDOW_SECONDS=60

# PostgreSQL
POSTGRES_DB=cyberpass
POSTGRES_USER=cyberpass
POSTGRES_PASSWORD=development-only-database-password
DATABASE_URL=postgresql+psycopg://cyberpass:development-only-database-password@postgres:5432/cyberpass

# S3-compatible object storage (MinIO locally)
MINIO_ROOT_USER=cyberpass-root
MINIO_ROOT_PASSWORD=development-only-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_BACKEND=s3
S3_ACCESS_KEY=cyberpass-app
S3_SECRET_KEY=development-only-storage-app-password
S3_BUCKET=cyberpass-evidence
S3_REGION=eu-west-1
SIGNED_URL_SECONDS=300
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY_BYTES=11534336

# AI. Keep OPENAI_API_KEY empty to use the deterministic mock provider.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
GENERATION_RATE_LIMIT=5
GENERATION_RATE_WINDOW_SECONDS=60
GENERATION_CONCURRENCY_PER_TENANT=1

# Browser/API security
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_SHARE_RATE_LIMIT=120
PUBLIC_SHARE_GLOBAL_RATE_LIMIT=2000
PUBLIC_SHARE_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=120
DOWNLOAD_GLOBAL_RATE_LIMIT=2000
FILE_RATE_WINDOW_SECONDS=60
TENANT_EVIDENCE_QUOTA=5000
TENANT_QUESTIONNAIRE_QUOTA=1000
